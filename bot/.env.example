# Local or VPS use only. On GitHub Actions the four keys come from
# repository Secrets (Settings → Secrets and variables → Actions) and
# must never be committed. This file is a template; copy it to bot/.env.

# X API v2 user-context credentials for the BOT account (OAuth 1.0a).
# Generate these in the developer portal AFTER setting the app to Read and Write.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Optional: also post each block to a Telegram channel. Both are needed. The token comes from
# @BotFather; the bot must be an administrator of the channel with the right to post messages.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHANNEL=@yourchannel
# TELEGRAM_INCLUDE_LINK=true
# TELEGRAM_TEMPLATE=Stratum V2 block #{height} mined by\n{pool}\n\nSubsidy + fees: {reward} BTC

# Optional: also post each block to a Discord channel. The value is the channel's webhook
# address (Edit Channel → Integrations → Webhooks). Treat it like a password.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# DISCORD_INCLUDE_LINK=true
# DISCORD_SUPPRESS_EMBEDS=false   (true hides the preview card under the block link)
# DISCORD_TEMPLATE=Stratum V2 block #{height} mined by\n{pool}\n\nSubsidy + fees: {reward} BTC

# Optional: also post each block to Nostr. The value is the bot account's private key
# (nsec1... or 64 hex digits). It is the account itself and cannot be revoked, so use a key
# made only for this bot.
# NOSTR_PRIVATE_KEY=
# NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol   (default: a built-in list of public relays)
# NOSTR_INCLUDE_LINK=true
# NOSTR_TEMPLATE=Stratum V2 block #{height} mined by\n{pool}\n\nSubsidy + fees: {reward} BTC

# Optional overrides
# STATE_FILE=state.json
# MEMPOOL_API=https://mempool.space
# X_TWEET_API=https://api.x.com/2/tweets
# POLL_INTERVAL=60
# USER_AGENT=sv2-x-bot/1.0
# TIMEZONE=Europe/Belgrade

# Used only if your TWEET_TEMPLATE includes {when}: hours in TIMEZONE treated as "overnight"
# (start inclusive, end exclusive). The default template does not use {when}.
# OVERNIGHT_START=0
# OVERNIGHT_END=7

# Per-pool SV2 totals inclusive of SV2_SEED_HEIGHT. Used only when state.json
# has no counts yet. MARA Pool reached 7 with block 977316 (24 Nov 2026),
# assuming no other MARA SV2 blocks were missed before that.
SV2_SEED_COUNTS=MARA Pool:7
SV2_SEED_HEIGHT=977316

# Default tweet (do not use \n here unless you are overriding it):
#   Stratum V2 block #{height} mined by
#   {pool}
#
#   Subsidy + fees: {reward} BTC
#
# {pool} is @handle when one is known, otherwise the plain pool name.
# {reward} is extras.reward in BTC with 3 decimal places.
# Optional template vars still available: {pool_name}, {when}, {nth}, {n}, {hash}, {tag}, {url}
# TWEET_TEMPLATE=Stratum V2 block #{height} mined by\n{pool}\n\nSubsidy + fees: {reward} BTC

# Append the mempool.space block URL on its own line at the end. Default is
# off: X's API currently charges more for posts that contain a URL
# ($0.20 vs $0.015). Check developer.x.com for current pricing. Set true or
# pass --block-link to include the URL.
# INCLUDE_BLOCK_LINK=false

# @mention the pool's X account instead of writing its plain name. Off by default: X's
# automation rules allow automated mentions only of accounts that have opted in, so switch
# this on only for pools that are happy to be tagged (or use POOL_HANDLES for single pools).
# MENTION_POOLS=false

# Path to the pool-handle database (default: pools.json next to the script).
# POOLS_FILE=pools.json

# Optional comma-separated Pool Name:@handle overrides for pools.json
# POOL_HANDLES=MARA Pool:@MARA
